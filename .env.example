# Bubble reads these from the environment it starts with; nothing loads this
# file by itself (export them, or `set -a; . ./.env; set +a` in a shell).
# Copy to .env, which stays out of Git, and fill in.

# Svix: `bubble webhook <event> [json]` sends Bubble's events to the endpoints
# a customer registers. Svix signs them (Standard Webhooks), retries what fails
# and keeps the delivery log. Empty: nothing is sent.
SVIX_API_KEY=

# The Svix application, one per customer, that owns those endpoints. Empty: bubble.
SVIX_APP_ID=

# Self-hosted Svix only. Empty: api.svix.com, with a key ending in .us, .eu,
# .in, .ca or .au picking the region.
SVIX_SERVER_URL=