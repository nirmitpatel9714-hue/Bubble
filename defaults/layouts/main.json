{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "link_handlers": [
    "open-link"
  ],
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 300
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "size": {
            "weight": 1
          },
          "min": 90,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "tab-list",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "tabs",
                "props": {
                  "list": true
                }
              }
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "weight": 1
          },
          "min": 120,
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents"
                  }
                },
                {
                  "id": "git",
                  "type": "block",
                  "content": {
                    "mod": "git"
                  }
                },
                {
                  "id": "diagnostics",
                  "type": "block",
                  "content": {
                    "mod": "diagnostics"
                  }
                },
                {
                  "id": "preview",
                  "type": "block",
                  "content": {
                    "mod": "preview"
                  }
                },
                {
                  "id": "ai",
                  "type": "block",
                  "content": {
                    "mod": "ai"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 96
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "top-bar",
          "type": "block",
          "size": {
            "px": 46
          },
          "hidden": true,
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
